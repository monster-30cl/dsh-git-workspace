{
  "name": "@monster-30cl/dsh-git-workspace-panel",
  "version": "0.1.0",
  "description": "Desktop Git review and branch-switching interface for dsh.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monster-30cl/dsh-git-workspace.git",
    "directory": "packages/panel"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
